# Environment Configuration Example for Barcode-Based Examination Attendance Portal
# Copy this file to .env and adjust variables as needed for production.

FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Secret Key for secure cookie sessions (generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# COE Administrative Master PIN for Emergency Unlocks
COE_OVERRIDE_PIN=COE@2026

# Database Path (defaults to local SQLite exam_attendance.db)
DATABASE_PATH=exam_attendance.db
